# Local development: npm ci && npm run start:dev
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200
MONGODB_URI=mongodb://127.0.0.1:27017/logithm
# Required even for development. Use separate `openssl rand -hex 32` values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Base URL only; backend adds /api/v2. Use a private isolated execution host.
PISTON_URL=http://127.0.0.1:2000

# Optional avatar storage: leave ALL blank to run without an avatar provider.
# Set URL plus a private service key (or public key with appropriate bucket RLS).
SUPABASE_URL=
SUPABASE_PUBLIC_KEY=
SUPABASE_PRIVATE_KEY=
SUPABASE_BUCKET=

# Production compose additionally requires these values. Use a separate private
# env file with `docker compose --env-file /secure/path/logithm.env ...`.
# CORS_ORIGINS must be the exact HTTPS origin, no path or trailing slash.
# PISTON_URL must reach the dedicated execution host over a private network.
# Generate independent URI-safe passwords: openssl rand -hex 32
MONGO_ROOT_USERNAME=logithm-admin
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080

# Dedicated executor-host compose only; pin a reviewed image digest for release.
PISTON_IMAGE=
PISTON_BIND_ADDRESS=127.0.0.1
PISTON_PORT=2000
